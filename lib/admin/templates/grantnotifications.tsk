import React from 'react';

interface GrantNotificationProps {
  documentTitle?: string;
  recipientName?: string;
  date?: string;
  documentNumber?: string;
  description?: string;
  signature?: string;
}

export default function GrantNotification({
  documentTitle = "Temporary Skill Shortage (subclass 482) Visa Grant",
  recipientName = "Jakir Hossain",
  date = "03 Aug 2026",
  documentNumber = "1859584856975",
  description = "Your visa has been granted successfully with approved conditions.",
  signature = "Steven (Department of Home Affairs)"
}: GrantNotificationProps) {
  return (
    <div className="max-w-[210mm] mx-auto bg-white shadow-lg p-10 my-8 print:shadow-none print:m-0 print:p-6 text-slate-800 font-sans text-sm leading-relaxed">
      <div className="border-b pb-4 mb-6 flex justify-between items-center">
        <div>
          <h1 className="text-lg font-bold text-slate-900">Australian Government</h1>
          <p className="text-xs text-slate-500">Department of Home Affairs</p>
        </div>
        <div className="text-right">
          <span className="bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1 rounded-full">GRANTED</span>
        </div>
      </div>

      <div className="mb-6">
        <h2 className="text-xl font-bold text-slate-900 mb-1">Dear {recipientName}</h2>
        <p className="text-slate-600">We have granted you a <span className="font-semibold text-slate-800">{documentTitle}</span> on {date}.</p>
      </div>

      <div className="bg-slate-50 border border-slate-200 rounded p-4 mb-6">
        <h3 className="font-semibold text-xs uppercase tracking-wider text-slate-700 mb-3">Visa Summary</h3>
        <div className="grid grid-cols-2 gap-y-2 text-xs">
          <div><span className="text-slate-500">Visa Grant Number:</span> <strong className="text-slate-800">{documentNumber}</strong></div>
          <div><span className="text-slate-500">Date of Grant:</span> <strong className="text-slate-800">{date}</strong></div>
          <div><span className="text-slate-500">Sponsor:</span> <strong className="text-slate-800">RTS Group Pty Ltd</strong></div>
          <div><span className="text-slate-500">Description:</span> <strong className="text-slate-800">{description}</strong></div>
        </div>
      </div>

      <div className="mt-12 pt-6 border-t border-slate-300 flex justify-between items-end text-xs">
        <div>
          <p className="font-semibold text-slate-700">Yours sincerely,</p>
          <p className="text-slate-600 mt-1">{signature}</p>
        </div>
        <button onClick={() => window.print()} className="print:hidden bg-indigo-600 text-white px-4 py-2 rounded text-xs font-medium hover:bg-indigo-700">
          Print Notice
        </button>
      </div>
    </div>
  );
}
